APP_NAME=Property Arena NG
APP_SLUG=property-arena
PORT=43121
NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/property_arena

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Used for verify-email / reset-password links (required in production)
FRONTEND_URL=http://127.0.0.1:43122

# Resend (preferred email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=PropertyArena <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=

# Optional auth email delivery fallback (pick one)
AUTH_EMAIL_WEBHOOK=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

PAYMENT_GATEWAY=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
SUBSCRIPTION_TRIAL_DAYS=30
BULL_BOARD_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@propertyarena.ng
SEED_ADMIN_PASSWORD=Admin123!
# One-time on production: set true, restart API, then set false
SEED_ON_BOOT=false
